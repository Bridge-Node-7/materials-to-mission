{
  "$id": "urn:bn7:m2m:view-contract:public-view:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Derived, read-only presentation contract. This is not a canonical Materials-to-Mission record schema and does not replace Python semantic validation.",
  "properties": {
    "action_options": {
      "items": {
        "enum": [
          "monitor",
          "validate",
          "support",
          "accelerate",
          "surge"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "decision_authority": {
      "const": "human"
    },
    "evidence_states": {
      "items": {
        "enum": [
          "supported",
          "unsupported",
          "unknown",
          "contradicted",
          "expired",
          "revoked",
          "superseded"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "presentation_mode": {
      "enum": [
        "explore",
        "examine",
        "decision-room"
      ]
    },
    "reviewed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "source_kind": {
      "enum": [
        "synthetic-case",
        "public-source-snapshot",
        "private-derived-view"
      ]
    },
    "source_reference": {
      "minLength": 1,
      "type": "string"
    },
    "support_items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "source_date": {
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "source_label": {
            "minLength": 1,
            "type": "string"
          },
          "support_state": {
            "enum": [
              "supported",
              "unsupported",
              "unknown",
              "contradicted",
              "expired",
              "revoked",
              "superseded"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "source_label",
          "source_date",
          "support_state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "toolkit_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "material",
              "processing",
              "required-form",
              "fabrication",
              "component",
              "validation",
              "qualification",
              "acquisition-access",
              "system",
              "mission"
            ]
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "supported",
              "unsupported",
              "unknown",
              "contradicted",
              "expired",
              "revoked",
              "superseded"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "validation_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "view_contract_version": {
      "const": "0.3.0"
    }
  },
  "required": [
    "view_contract_version",
    "source_kind",
    "source_reference",
    "presentation_mode",
    "decision_authority",
    "evidence_states",
    "trace_nodes",
    "support_items"
  ],
  "title": "Materials-to-Mission Public View Contract 0.3.0",
  "type": "object"
}
