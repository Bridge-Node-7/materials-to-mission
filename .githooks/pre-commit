#!/usr/bin/env bash
set -euo pipefail

FAIL=0

echo "=== BN7 PRE-COMMIT SECURITY CHECK ==="

if [ -f scripts/check_privacy.py ]; then
    python scripts/check_privacy.py --staged || FAIL=1
fi

EMAIL="$(git config user.email || true)"

if [[ "$EMAIL" != *"users.noreply.github.com" ]]; then
    echo "WARNING: non GitHub noreply email:"
    echo "$EMAIL"
fi

if [ -f scripts/build_manifest.py ]; then
    python scripts/build_manifest.py --check || FAIL=1
fi

exit $FAIL
